!data/raw/mvtec_ad/.gitkeep
data/raw/mvtec_loco/*
!data/raw/mvtec_loco/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep

# Generated evaluation results & temporary dumps
results/
artifacts/*.zip
*.zip
*.tar
*.tar.xz
*.tar.gz

artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
artifacts/onnx/*
!artifacts/onnx/.gitkeep
artifacts/openvino_fp32/*
!artifacts/openvino_fp32/.gitkeep
artifacts/openvino_ptq_int8/*
!artifacts/openvino_ptq_int8/.gitkeep
artifacts/openvino_mixed_int8/*
!artifacts/openvino_mixed_int8/.gitkeep

# Experiment tracking
mlruns/
mlartifacts/
mlflow.db
wandb/

