*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Datasets & heavy artifacts (reproducible via scripts)
data/raw/*
!data/raw/.gitkeep
!data/raw/mvtec_ad/.gitkeep
!data/raw/mvtec_loco/.gitkeep
