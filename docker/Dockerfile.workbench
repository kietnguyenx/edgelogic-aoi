FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    python-multipart \
    websockets \
    numpy \
    opencv-python-headless \
    openvino

COPY api /app/api
COPY python_research/__init__.py /app/python_research/__init__.py
COPY python_research/calibration /app/python_research/calibration
COPY python_research/vlm_copilot /app/python_research/vlm_copilot

EXPOSE 8088
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8088"]