# Stage 1: Build C++17 OpenVINO Edge Engine
FROM openvino/ubuntu22_dev:latest AS builder

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY cpp_edge_engine /src/cpp_edge_engine

RUN cmake -S /src/cpp_edge_engine -B /build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build -j$(nproc)

# Stage 2: Minimal Industrial Edge Runtime
FROM openvino/ubuntu22_runtime:latest AS runtime

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopencv-core4.5d \
    libopencv-imgproc4.5d \
    libopencv-imgcodecs4.5d \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/edgelogic_aoi /app/edgelogic_aoi

USER openvino
ENTRYPOINT ["/app/edgelogic_aoi"]